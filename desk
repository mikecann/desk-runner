#!/usr/bin/env python3
"""Run a shell command through Desk Runner, so it has Screen Recording and
Accessibility permission.

  desk 'screencapture -x shot.png'
  desk < script.sh
  desk --permissions
"""
import json
import os
import select
import socket
import stat
import sys
import time
import uuid

SOCKET = os.path.expanduser("~/Library/Application Support/Desk Runner/runner.sock")
MARKER = b"\x00DESK_RC="
# Above 127 makes git bisect run abort instead of treating transport loss as a skipped commit.
TRANSPORT_ERROR = 255


def report(message: str) -> None:
    try:
        print(message, file=sys.stderr)
    except BrokenPipeError:
        # stderr may share stdout's closed pipe (desk ... 2>&1 | head).
        with open(os.devnull, "wb") as sink:
            os.dup2(sink.fileno(), sys.stderr.fileno())


def main(request_id: str) -> int:
    if sys.argv[1:] == ["--permissions"]:
        command = "__permissions"
    elif len(sys.argv) > 1:
        command = " ".join(sys.argv[1:])
    else:
        command = sys.stdin.read()
    started = time.monotonic()
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.connect(SOCKET)
    except OSError as error:
        report(f"Desk Runner isn't running ({error}). Start it with: open -a 'Desk Runner'")
        return 127
    held = b""
    failure = "connection closed before an exit status arrived"
    with client:
        try:
            client.sendall((json.dumps({"cmd": command, "cwd": os.getcwd(), "id": request_id}) + "\n").encode())
        except OSError as error:
            failure = f"connection failed: {error}"
        else:
            # A dropped SSH session closes our stdout, but a quiet command
            # would never write to find out. macOS flags a pipe whose reader
            # is gone as POLLHUP; leaving then makes the service stop the command.
            waiter = select.poll()
            waiter.register(client, select.POLLIN)
            watch_stdout = stat.S_ISFIFO(os.fstat(1).st_mode) or stat.S_ISSOCK(os.fstat(1).st_mode)
            stdout_watcher = select.poll()
            stdout_watcher.register(1, select.POLLOUT)
            while True:
                if not waiter.poll(1000):
                    if watch_stdout and any(e & (select.POLLHUP | select.POLLERR)
                                            for _, e in stdout_watcher.poll(0)):
                        raise BrokenPipeError
                    continue
                try:
                    chunk = client.recv(65536)
                except OSError as error:
                    failure = f"connection failed: {error}"
                    break
                if not chunk:
                    break
                held += chunk
                # Keep back enough to spot the exit-code marker if it's split.
                cut = held.rfind(MARKER)
                if cut >= 0:
                    safe = cut
                else:
                    # Ordinary output can be flushed immediately. Only a suffix
                    # matching the start of the marker needs another read.
                    keep = max((n for n in range(1, len(MARKER)) if held.endswith(MARKER[:n])), default=0)
                    safe = len(held) - keep
                sys.stdout.buffer.write(held[:safe])
                sys.stdout.buffer.flush()
                held = held[safe:]
    if held.startswith(MARKER):
        status = held[len(MARKER):].strip()
        if held.endswith(b"\n") and status.isdigit() and len(status) <= 3 and 0 <= int(status) <= 255:
            return int(status)
        failure = "invalid or incomplete exit status from the service"
    sys.stdout.buffer.write(held)
    sys.stdout.buffer.flush()
    report(
        f"Desk Runner: {failure} (request {request_id}, after {time.monotonic() - started:.1f}s). "
        "The command's result is unknown. If the service went away, it stopped the command "
        "too, but anything already done (clicks, files) stays done, so check before retrying. "
        "Service logs: log show --last 10m --predicate 'subsystem == \"com.mikecann.desk-runner\"'."
    )
    return TRANSPORT_ERROR


if __name__ == "__main__":
    request_id = uuid.uuid4().hex
    try:
        sys.exit(main(request_id))
    except KeyboardInterrupt:
        report(f"Desk Runner: interrupted (request {request_id}). The service stops the command "
               "when its client goes away; check what it already did before retrying.")
        sys.exit(130)
    except BrokenPipeError:
        # Prevent a second exception when Python flushes stdout during shutdown.
        with open(os.devnull, "wb") as sink:
            os.dup2(sink.fileno(), sys.stdout.fileno())
        report("Desk Runner: output consumer closed, so the command was stopped. "
               "Check what it already did before retrying.")
        sys.exit(141)
